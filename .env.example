# Local development defaults. Copy to `.env` and edit as needed.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full URLs (with scheme) for HTTPS deployments. Required by
# Django >= 4 for any POST over HTTPS from a domain not listed here.
# Example for Render: DJANGO_CSRF_TRUSTED_ORIGINS=https://discord-django.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: when set, overrides the default SQLite database (e.g. on Render).
# Render injects this automatically when a Postgres service is linked, so
# leave it blank for local dev.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

MAX_UPLOAD_SIZE_BYTES=10485760
